{
  "manifest_version": 2,
  "name": "Glosbe: enlazar palabras",
  "version": "1.0.0",
  "description": "Convierte las palabras del texto de la página actual en enlaces a Glosbe.",
  "permissions": ["activeTab"],
  "browser_action": {
    "default_title": "Enlazar palabras con Glosbe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "glosbe-word-links@example.local",
      "strict_min_version": "109.0"
    }
  }
}